# Baza danych, wstrzykiwane automatycznie przez integrację Neon Postgres
# w panelu Vercel (Storage → Marketplace → Neon). Nie trzeba ustawiać ręcznie
# na produkcji, tylko lokalnie (np. przez `vercel env pull`, albo żeby
# uruchomić scripts/manage-users.js).
DATABASE_URL=

# Sekret do podpisywania sesji admina (dowolny długi losowy ciąg znaków).
ADMIN_SESSION_SECRET=

# Sekret do autoryzacji crona moderacji spamu (api/cron/check-spam.js).
# Vercel Cron sam dokłada nagłówek "Authorization: Bearer <ta wartość>" do
# wywołań, jeśli zmienna o tej dokładnie nazwie jest ustawiona w projekcie.
# Dowolny długi losowy ciąg znaków.
CRON_SECRET=

# Klucz do darmowego API Groq (https://console.groq.com/keys), używanego przez
# cron moderacji do klasyfikowania nowych zgłoszeń jako spam/nie spam.
GROQ_API_KEY=

# Opcjonalnie: nadpisanie domyślnego modelu Groq (llama-3.1-8b-instant).
GROQ_MODEL=
